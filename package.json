{
  "name": "gooseblog-hexo",
  "version": "1.0.0",
  "private": true,
  "description": "GooseBlog — 从 Cloudflare Pages SPA + Supabase 迁移到 Hexo 静态站（主题：hexo-theme-redefine）",
  "scripts": {
    "build": "hexo clean && hexo generate && npm run cache-bust",
    "clean": "hexo clean",
    "generate": "hexo generate && npm run cache-bust",
    "cache-bust": "node scripts/cache-bust.js",
    "server": "hexo server",
    "import:csv": "node tools/import-from-csv.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-generator-searchdb": "^1.4.1",
    "hexo-wordcount": "^6.0.1",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-sitemap": "^3.0.1"
  }
}
